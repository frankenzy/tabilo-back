# Copier en .env et adapter. Aucun secret réel ne doit être versionné.
NODE_ENV=development
APP_PORT=3090
DATABASE_URL=postgresql://tabilo:tabilo_local@127.0.0.1:5434/tabilo?schema=public
REDIS_URL=redis://127.0.0.1:6381
# 32 caractères minimum, généré par : openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
# Origines autorisées (CORS + WebSocket), séparées par des virgules
CORS_ORIGINS=http://localhost:3004
# URL publique du frontend, utilisée dans les QR codes
PUBLIC_WEB_URL=http://localhost:3004
COOKIE_SECURE=false
SWAGGER_ENABLED=true
# false sur une instance API pure quand un worker dédié tourne à côté
WORKER_ENABLED=true
