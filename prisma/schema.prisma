// TABILO — modèle relationnel.
// Règles transverses :
//  - toute donnée métier porte tenantId (+ establishmentId quand elle appartient à un établissement) ;
//  - les horodatages sont en UTC (timestamptz), présentés dans le fuseau de l'établissement ;
//  - pas de suppression physique des données traçables : deletedAt (archivage) ou onDelete: Restrict ;
//  - clés étrangères composites (id, establishmentId) là où un rattachement croisé entre
//    établissements serait une fuite inter-tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
}

enum UserStatus {
  active
  disabled
}

enum QrStatus {
  active
  revoked
}

enum SessionStatus {
  open
  closed
  expired
  /// Spec 027, R4 : toutes les commandes de la session sont servies et réglées.
  settled
}

/// Spec 027, R8 : position du client par rapport à la zone de l'établissement, au moment de commander.
enum ZoneCheck {
  inside
  outside
  imprecise
  denied
}

/// Spec 027, R9 : origine d'une alerte de départ sans payer.
enum UnpaidAlertReason {
  inactivity
  released
  expired
}

/// Spec 027, R9 : suite donnée à une alerte.
enum UnpaidAlertResolution {
  paid
  still_here
  walked_out
}

/// Spec 030, R1 : façon de servir d'un établissement, figée sur chaque commande (R2).
enum ServiceMode {
  /// Servir puis régler (maquis, par défaut).
  serve_then_pay
  /// Régler quand on veut : addition et règlement possibles avant le service.
  pay_anytime
  /// Régler à la caisse d'abord : la commande attend l'encaissement avant la préparation.
  pay_first
}

enum RequestStatus {
  /// Spec 030, R6 : commande à encaisser avant la préparation (« Caisse d'abord »).
  awaiting_payment
  pending
  assigned
  accepted
  in_progress
  /// Spec 007 : commande prête, en attente d'être servie (établissements à cuisine séparée).
  ready
  resolved
  cancelled
}

enum EscalationStatus {
  none
  escalated
  acknowledged
}

enum RequestPriority {
  normal
  high
}

enum RequestSource {
  customer
  staff
}

enum ActorType {
  customer
  staff
  system
}

enum RequestTypeKind {
  /// Demande de service (serveur, eau, addition…), proposée telle quelle au client.
  service
  /// Commande passée depuis la carte. Un seul type de ce genre par établissement.
  order
  /// Spec 028 : « L'addition », demande de facture d'un client. Un seul type de ce genre par établissement.
  bill
  /// Spec 029 : « Appel », le client appelle un serveur d'un toucher. Un seul par établissement.
  call
  /// Spec 029 : « Message », le client écrit au personnel. Un seul par établissement.
  message
}

enum EscalationTrigger {
  not_accepted
  not_resolved
}

/// Client de la plateforme (société exploitante). Racine de l'isolation des données.
model Tenant {
  id                String       @id @default(uuid()) @db.Uuid
  name              String
  status            TenantStatus @default(active)
  /// Spec 034 : formule d'abonnement.
  plan              PlanKey      @default(pro)
  /// Spec 035, R1 : essai, actif, en retard, suspendu. Distinct de `status` (blocage technique).
  accountState      AccountState @default(trial)
  /// Spec 035 : échéance (fin d'essai ou fin de la période payée).
  paidUntil         DateTime     @default(now()) @db.Timestamptz(3)
  /// Spec 036, R4 : suspension décidée par l'éditeur ; la tâche quotidienne ne la lève pas.
  manuallySuspended Boolean      @default(false)
  /// Spec 041, R2 : version des conditions et de la politique acceptée par le propriétaire.
  termsVersion      String?
  termsAcceptedAt   DateTime?    @db.Timestamptz(3)
  /// Spec 041, R3 : dernier export des données (un par heure au plus).
  lastExportAt      DateTime?    @db.Timestamptz(3)
  /// Spec 041, R4 et R5 : compte fermé par l'éditeur, effacé après `deleteAfter` ; `erasedAt` une fois effacé.
  closedAt          DateTime?    @db.Timestamptz(3)
  closeReason       String?
  deleteAfter       DateTime?    @db.Timestamptz(3)
  erasedAt          DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  establishments Establishment[]
  users          User[]
  roles          Role[]
  payments       SubscriptionPayment[]
}

/// Spec 034, R1 : formules d'abonnement (catalogue dans commons/constants/plans.ts).
enum PlanKey {
  essentiel
  pro
  premium
}

/// Spec 035, R1.
enum AccountState {
  trial
  active
  past_due
  suspended
}

/// Spec 037, R1 : moyens de paiement de l'abonnement.
enum PaymentMethod {
  cash
  orange_money
  mtn_momo
  moov_money
  wave
  bank_transfer
}

/// Spec 037 : paiement d'abonnement enregistré par l'éditeur, et son reçu (jamais supprimé, R5).
model SubscriptionPayment {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  /// Numéro de reçu `AAAA-NNNN`, sans trou par année (R4).
  number            String        @unique
  amountMinor       Int
  method            PaymentMethod
  reference         String?
  months            Int
  plan              PlanKey
  /// Période couverte.
  periodStart       DateTime      @db.Timestamptz(3)
  periodEnd         DateTime      @db.Timestamptz(3)
  /// Échéance avant ce paiement : rétablie si le paiement est annulé (R5).
  previousPaidUntil DateTime      @db.Timestamptz(3)
  createdById       String        @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  cancelledAt       DateTime?     @db.Timestamptz(3)
  cancelReason      String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
}

/// Spec 037, R4 : compteur de reçus par année, verrouillé à chaque numéro.
model ReceiptCounter {
  year Int @id
  last Int @default(0)
}

/// Spec 036, R1 : compte de l'éditeur, hors de tout compte client.
model PlatformAdmin {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  name             String
  passwordHash     String
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(3)
  lastLoginAt      DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  sessions PlatformSession[]
}

/// Spec 036, R7 : session de la console (jeton opaque en cookie HttpOnly, haché en base), 8 heures.
model PlatformSession {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

/// Spec 036, R6 : journal de la plateforme, ni modifiable ni effaçable depuis l'application.
model PlatformAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @db.Uuid
  tenantId  String?  @db.Uuid
  action    String
  reason    String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
}

/// Spec 036, R5 : lien de réinitialisation du mot de passe, à usage unique, 24 heures.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

/// Point de vente (restaurant, café, glacier). Porte le paramétrage opérationnel.
model Establishment {
  id                        String      @id @default(uuid()) @db.Uuid
  tenantId                  String      @db.Uuid
  name                      String
  timezone                  String      @default("Africa/Abidjan")
  /// Devise des prix de la carte (code ISO 4217).
  currency                  String      @default("XOF")
  address                   String?
  phone                     String?
  /// Durée de validité d'une session de table après un scan.
  sessionTtlMinutes         Int         @default(180)
  /// Nombre maximal de demandes non terminées par table.
  maxActiveRequestsPerTable Int         @default(5)
  /// Nombre maximal de demandes créées par une même session.
  maxRequestsPerSession     Int         @default(30)
  /// Délai minimal entre deux demandes d'une même session.
  requestCooldownSeconds    Int         @default(10)
  /// Spec 007 : une cuisine séparée signale les commandes prêtes au serveur (étape « Prête »).
  separateKitchen           Boolean     @default(false)
  /// Spec 012, R7 : rangée « Souvent pris avec » dans la fiche d'un plat (désactivée par défaut).
  pairingsEnabled           Boolean     @default(false)
  /// Spec 027, R8 et R12 : centre de la zone de l'établissement (NULL = pas de zone, aucune position demandée).
  zoneLatitude              Float?
  zoneLongitude             Float?
  /// Rayon de la zone, en mètres (50 à 500).
  zoneRadiusM               Int         @default(150)
  /// Délai sans activité avant l'alerte de départ sans payer, en minutes (10 à 60).
  unpaidAlertMinutes        Int         @default(20)
  /// Spec 030, R1 : façon de servir.
  serviceMode               ServiceMode @default(serve_then_pay)
  /// Spec 030, R9 : une commande envoyée part directement en préparation (sans effet en pay_first).
  autoStartOrders           Boolean     @default(false)
  /// Spec 031, R1 : logo (image carrée, servie comme une photo de plat).
  logoImageId               String?     @unique @db.Uuid
  /// Spec 031, R2 : couleur principale, clé de la palette fermée (establishments/branding.ts).
  brandColor                String      @default("orange")
  /// Spec 031, R6 : mot d'accueil facultatif, 80 caractères au plus.
  welcomeText               String?
  createdAt                 DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime    @updatedAt @db.Timestamptz(3)
  archivedAt                DateTime?   @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  logo            MenuImage?       @relation("EstablishmentLogo", fields: [logoImageId], references: [id], onDelete: SetNull)
  memberships     Membership[]
  areas           DiningArea[]
  tables          DiningTable[]
  qrCodes         QrCode[]
  sessions        TableSession[]
  requestTypes    RequestType[]
  requests        ServiceRequest[]
  escalationRules EscalationRule[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  unpaidAlerts    UnpaidAlert[]

  @@index([tenantId])
}

/// Compte du personnel. Un utilisateur appartient à un seul tenant.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @db.Uuid
  email              String     @unique
  passwordHash       String
  firstName          String
  lastName           String
  status             UserStatus @default(active)
  mustChangePassword Boolean    @default(false)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?  @db.Timestamptz(3)
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships      Membership[]
  refreshSessions  RefreshSession[]
  notifications    Notification[]
  assignedRequests ServiceRequest[] @relation("RequestAssignee")

  @@index([tenantId])
}

/// Rôle. tenantId NULL = rôle système (owner, manager, waiter), non modifiable.
/// Les permissions sont des clés du catalogue versionné dans le code (commons/constants/permissions).
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  key         String
  name        String
  isSystem    Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// Périmètre d'accès explicite : un utilisateur, un établissement, un rôle.
model Membership {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  userId             String   @db.Uuid
  establishmentId    String   @db.Uuid
  roleId             String   @db.Uuid
  /// Spec 010 : permissions du rôle retirées à cet employé. Effectives = rôle − retirées ; jamais au-delà du rôle.
  revokedPermissions String[] @default([])
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  role          Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, establishmentId])
  @@index([establishmentId])
}

/// Session d'authentification (refresh token haché, rotation par famille).
model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Zone de salle (terrasse, étage…).
model DiningArea {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  establishmentId String    @db.Uuid
  name            String
  position        Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime? @db.Timestamptz(3)

  establishment Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  tables        DiningTable[]
  requests      ServiceRequest[]

  @@unique([id, establishmentId])
  @@index([establishmentId, archivedAt])
}

/// Table physique. Le libellé est unique parmi les tables actives d'un établissement
/// (index unique partiel créé dans la migration).
model DiningTable {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  establishmentId String    @db.Uuid
  areaId          String    @db.Uuid
  label           String
  seats           Int       @default(2)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime? @db.Timestamptz(3)

  establishment Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  area          DiningArea       @relation(fields: [areaId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  qrCodes       QrCode[]
  sessions      TableSession[]
  requests      ServiceRequest[]

  @@unique([id, establishmentId])
  @@index([establishmentId, archivedAt])
  @@index([areaId])
}

/// QR code permanent d'une table. `code` est un identifiant public imprimé (pas un secret) :
/// il ne donne accès à rien sans ouverture de session, et se révoque.
model QrCode {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  establishmentId String    @db.Uuid
  tableId         String    @db.Uuid
  code            String    @unique
  status          QrStatus  @default(active)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  /// Spec 042, R5 : dernière impression de ce QR ; NULL = jamais imprimé (nouvelle table ou QR régénéré).
  printedAt       DateTime? @db.Timestamptz(3)

  establishment Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  table         DiningTable    @relation(fields: [tableId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  sessions      TableSession[]

  @@index([tableId, status])
}

/// Session de table ouverte par un scan. Le jeton n'est stocké que haché (SHA-256).
model TableSession {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  establishmentId   String        @db.Uuid
  tableId           String        @db.Uuid
  qrCodeId          String        @db.Uuid
  tokenHash         String        @unique
  status            SessionStatus @default(open)
  requestCount      Int           @default(0)
  lastRequestAt     DateTime?     @db.Timestamptz(3)
  openedAt          DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime      @db.Timestamptz(3)
  closedAt          DateTime?     @db.Timestamptz(3)
  closedById        String?       @db.Uuid
  /// Spec 027, R2 : repère de la session (index dans le catalogue). Unique parmi les sessions ouvertes
  /// d'une table (index partiel SQL, migration session_par_client).
  markerIndex       Int           @default(0)
  /// Spec 027, R9 : dernière commande, demande ou règlement de la session.
  lastActivityAt    DateTime      @default(now()) @db.Timestamptz(3)
  /// Spec 027, R9 : « Client encore là » — pas de nouvelle alerte avant cette heure.
  alertSnoozedUntil DateTime?     @db.Timestamptz(3)
  /// Spec 043, R2 : carte de fidélité présentée par ce téléphone (sans compte).
  loyaltyCardId     String?       @db.Uuid

  establishment Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  table         DiningTable      @relation(fields: [tableId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  qrCode        QrCode           @relation(fields: [qrCodeId], references: [id], onDelete: Restrict)
  requests      ServiceRequest[]
  unpaidAlerts  UnpaidAlert[]

  @@index([tableId, status])
  @@index([status, expiresAt])
}

/// Type de demande configurable par établissement.
model RequestType {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  establishmentId String          @db.Uuid
  label           String
  kind            RequestTypeKind @default(service)
  icon            String          @default("bell")
  priority        RequestPriority @default(normal)
  /// Délai cible de prise en charge (acceptation), en secondes. Au-delà, la demande est « en retard ».
  slaSeconds      Int             @default(180)
  allowNote       Boolean         @default(true)
  /// Spec 027, R6 : demande propre à chaque client (« L'addition »), pas regroupée par table.
  perSession      Boolean         @default(false)
  isActive        Boolean         @default(true)
  position        Int             @default(0)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?       @db.Timestamptz(3)

  establishment   Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  requests        ServiceRequest[]
  escalationRules EscalationRule[]

  @@unique([id, establishmentId])
  @@index([establishmentId, archivedAt])
}

/// Demande de service. Les horodatages d'étape sont écrits dans la même transaction
/// que l'événement correspondant : ils servent de base aux indicateurs.
model ServiceRequest {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  establishmentId  String           @db.Uuid
  tableId          String           @db.Uuid
  areaId           String           @db.Uuid
  requestTypeId    String           @db.Uuid
  sessionId        String?          @db.Uuid
  source           RequestSource
  note             String?
  /// Quantité demandée pour une demande de service (ex. 2 bouteilles d'eau, spec 005). NULL = non précisée.
  quantity         Int?
  priority         RequestPriority  @default(normal)
  status           RequestStatus    @default(pending)
  escalationStatus EscalationStatus @default(none)
  assigneeId       String?          @db.Uuid
  createdById      String?          @db.Uuid
  idempotencyKey   String?
  /// Total d'une commande, en unité mineure de la devise. NULL pour une demande de service.
  totalMinor       Int?
  /// Verrou optimiste : incrémenté à chaque transition.
  version          Int              @default(0)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  dueAt            DateTime         @db.Timestamptz(3)
  assignedAt       DateTime?        @db.Timestamptz(3)
  acceptedAt       DateTime?        @db.Timestamptz(3)
  startedAt        DateTime?        @db.Timestamptz(3)
  readyAt          DateTime?        @db.Timestamptz(3)
  resolvedAt       DateTime?        @db.Timestamptz(3)
  cancelledAt      DateTime?        @db.Timestamptz(3)
  escalatedAt      DateTime?        @db.Timestamptz(3)
  /// Spec 026 : commande servie réglée par le client. Axe distinct du statut ; NULL = à régler.
  paidAt           DateTime?        @db.Timestamptz(3)
  /// Spec 027, R8 : résultat de la vérification de zone (NULL = pas de zone). Aucune coordonnée du client.
  zoneCheck        ZoneCheck?
  /// Distance arrondie à la zone, en mètres, quand le client est hors zone.
  zoneDistanceM    Int?
  /// Spec 027, R9 : « Parti sans payer ». La commande sort du reste à encaisser.
  writtenOffAt     DateTime?        @db.Timestamptz(3)
  writtenOffById   String?          @db.Uuid
  /// Spec 030, R2 : façon de servir figée à l'envoi d'une commande ; NULL = demande de service ou commande antérieure (servir puis régler).
  serviceMode      ServiceMode?

  establishment Establishment         @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  table         DiningTable           @relation(fields: [tableId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  requestType   RequestType           @relation(fields: [requestTypeId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  area          DiningArea            @relation(fields: [areaId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  session       TableSession?         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  assignee      User?                 @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignments   ServiceAssignment[]
  events        ServiceRequestEvent[]
  items         ServiceRequestItem[]

  @@unique([establishmentId, idempotencyKey])
  @@index([establishmentId, status, createdAt])
  @@index([establishmentId, createdAt])
  @@index([assigneeId, status])
  @@index([tableId, status])
  @@index([sessionId])
}

/// Historique des affectations d'une demande (qui, par qui, pourquoi, jusqu'à quand).
model ServiceAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  establishmentId String    @db.Uuid
  requestId       String    @db.Uuid
  assigneeId      String    @db.Uuid
  assignedById    String?   @db.Uuid
  reason          String?
  assignedAt      DateTime  @default(now()) @db.Timestamptz(3)
  endedAt         DateTime? @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([assigneeId, assignedAt])
}

/// Journal append-only des événements métier d'une demande. Jamais modifié ni supprimé.
model ServiceRequestEvent {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  establishmentId String         @db.Uuid
  requestId       String         @db.Uuid
  type            String
  fromStatus      RequestStatus?
  toStatus        RequestStatus?
  actorType       ActorType
  actorId         String?        @db.Uuid
  payload         Json?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([establishmentId, createdAt])
}

/// Règle d'escalade : déclenche une alerte de supervision après un délai.
model EscalationRule {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  establishmentId String            @db.Uuid
  name            String
  trigger         EscalationTrigger
  afterSeconds    Int
  /// NULL = tous les types de demande.
  requestTypeId   String?           @db.Uuid
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?         @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  requestType   RequestType?  @relation(fields: [requestTypeId, establishmentId], references: [id, establishmentId], onDelete: Restrict)

  @@index([establishmentId, isActive])
}

/// Notification persistée destinée à un membre du personnel.
model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  establishmentId String    @db.Uuid
  userId          String    @db.Uuid
  type            String
  title           String
  body            String?
  requestId       String?   @db.Uuid
  /// Identifiant de l'événement d'origine : garantit l'absence de doublon en cas de rejeu.
  sourceEventId   BigInt?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  readAt          DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceEventId])
  @@index([userId, establishmentId, readAt, createdAt])
}

/// Journal d'audit (administration et sécurité). Append-only.
model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String?  @db.Uuid
  establishmentId String?  @db.Uuid
  actorId         String?  @db.Uuid
  action          String
  entityType      String?
  entityId        String?
  metadata        Json?
  ip              String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, establishmentId, createdAt])
  @@index([actorId, createdAt])
}

/// Transactional outbox : écrit dans la transaction métier, diffusé après validation.
model OutboxEvent {
  id              BigInt    @id @default(autoincrement())
  tenantId        String    @db.Uuid
  establishmentId String    @db.Uuid
  type            String
  payload         Json
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt     DateTime? @db.Timestamptz(3)
  attempts        Int       @default(0)

  @@index([publishedAt, id])
  @@index([establishmentId, id])
}

/// Rubrique de la carte (entrées, plats, boissons…).
model MenuCategory {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  establishmentId String    @db.Uuid
  name            String
  /// Pictogramme de la rubrique (liste fermée, voir menu/category-icons.ts) : la carte se lit sans savoir lire (spec 003).
  icon            String    @default("utensils")
  /// Photo de la rubrique ; si présente, elle remplace le pictogramme côté client.
  imageId         String?   @unique @db.Uuid
  position        Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime? @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  image         MenuImage?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  items         MenuItem[]

  @@unique([id, establishmentId])
  @@index([establishmentId, archivedAt])
}

/// Article de la carte. Le prix est un entier en unité mineure de la devise de l'établissement
/// (1 500 F CFA = 1500 ; 8,50 € = 850) : jamais de nombre à virgule pour de l'argent.
model MenuItem {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  establishmentId   String    @db.Uuid
  categoryId        String    @db.Uuid
  name              String
  description       String?
  priceMinor        Int
  imageId           String?   @unique @db.Uuid
  /// false = en rupture : affiché, mais non commandable.
  isAvailable       Boolean   @default(true)
  /// Spec 032 : formule (pack) à prix unique, composée d'un choix par rubrique (MenuBundleGroup).
  isBundle          Boolean   @default(false)
  /// Spec 033, R1 : prix promotionnel, strictement inférieur au prix ; NULL = pas de promotion.
  promoPriceMinor   Int?
  /// Spec 039, R2 : créneaux de la promotion — [{ days: [1..7], start: "HH:MM", end: "HH:MM" }] ; NULL = permanente.
  promoSlots        Json?
  /// Spec 039, Q1 : nom de la promotion programmée (« Happy hour » par défaut à l'affichage).
  promoName         String?
  /// Spec 039, R3 : créneaux de disponibilité ; NULL = toujours disponible.
  availabilitySlots Json?
  position          Int       @default(0)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime? @db.Timestamptz(3)

  establishment Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  category      MenuCategory      @relation(fields: [categoryId, establishmentId], references: [id, establishmentId], onDelete: Restrict)
  image         MenuImage?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  bundleGroups  MenuBundleGroup[]
  optionGroups  MenuOptionGroup[]

  @@unique([id, establishmentId])
  @@index([establishmentId, archivedAt])
  @@index([categoryId])
}

/// Spec 038, R1 : groupe d'options d'un plat (taille, accompagnement, suppléments).
model MenuOptionGroup {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @db.Uuid
  establishmentId String  @db.Uuid
  itemId          String  @db.Uuid
  name            String
  /// Plusieurs choix possibles (sinon un seul).
  multiple        Boolean @default(false)
  required        Boolean @default(false)
  position        Int

  item    MenuItem     @relation(fields: [itemId, establishmentId], references: [id, establishmentId], onDelete: Cascade)
  options MenuOption[]

  @@index([itemId])
}

/// Spec 038, R1 : une option et son supplément (0 ou plus).
model MenuOption {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @db.Uuid
  establishmentId String  @db.Uuid
  groupId         String  @db.Uuid
  name            String
  priceMinor      Int     @default(0)
  /// Pictogramme facultatif (mêmes clés que les rubriques).
  icon            String?
  /// Spec 038, R6 : option indisponible, grisée.
  isAvailable     Boolean @default(true)
  position        Int

  group MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

/// Spec 032, R1 : rubrique d'une formule (« Plat », « Boisson »…) et les plats proposés, dans l'ordre.
/// Les plats sont contrôlés à l'écriture (même établissement, plats simples) ; un plat archivé disparaît à la lecture (R7).
model MenuBundleGroup {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  establishmentId String   @db.Uuid
  bundleId        String   @db.Uuid
  name            String
  position        Int
  choiceIds       String[] @db.Uuid

  bundle MenuItem @relation(fields: [bundleId, establishmentId], references: [id, establishmentId], onDelete: Cascade)

  @@index([bundleId])
}

/// Photo d'un article, stockée en base (image réduite par le navigateur avant envoi).
/// Servie publiquement par son identifiant imprévisible : une photo de plat n'est pas un secret.
model MenuImage {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  establishmentId String   @db.Uuid
  mime            String
  data            Bytes
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  item              MenuItem?
  category          MenuCategory?
  /// Spec 031 : logo d'un établissement.
  establishmentLogo Establishment? @relation("EstablishmentLogo")
  /// Spec 046 : image d'un lot du panier de cadeaux.
  loyaltyPrize      LoyaltyPrize?

  @@index([establishmentId])
}

/// Ligne d'une commande. Nom et prix sont figés à la commande : modifier la carte ensuite
/// ne réécrit pas l'historique.
model ServiceRequestItem {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String                   @db.Uuid
  establishmentId String                   @db.Uuid
  requestId       String                   @db.Uuid
  menuItemId      String                   @db.Uuid
  name            String
  unitPriceMinor  Int
  quantity        Int
  /// Spec 032, R5 : choix d'une formule, figés à la commande — [{ group, menuItemId, name }]. NULL pour un plat.
  choices         Json?
  /// Spec 038, R5 : options choisies, figées — [{ group, optionId, name, priceMinor }]. NULL sans option.
  options         Json?
  /// Spec 033, R1 et R7 : prix de la carte quand la ligne a été commandée en promotion (unitPriceMinor = prix promo).
  listPriceMinor  Int?
  /// Spec 033, R4 : ligne offerte (table à part : la ligne elle-même reste figée, append-only).
  offer           ServiceRequestItemOffer?

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

/// Spec 027, R9 : alerte de départ sans payer, traitée par le gérant.
/// Une seule alerte ouverte par session (index partiel SQL, migration session_par_client).
model UnpaidAlert {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @db.Uuid
  establishmentId String                 @db.Uuid
  tableId         String                 @db.Uuid
  sessionId       String                 @db.Uuid
  /// Montant servi et non réglé de la session au moment de l'alerte.
  amountMinor     Int
  reason          UnpaidAlertReason
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  resolvedAt      DateTime?              @db.Timestamptz(3)
  resolution      UnpaidAlertResolution?
  resolvedById    String?                @db.Uuid

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  session       TableSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([establishmentId, resolvedAt])
  @@index([sessionId])
}

/// Spec 043, R1 : carte de fidélité d'un établissement (une au plus).
model LoyaltyProgram {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @db.Uuid
  establishmentId  String      @unique @db.Uuid
  /// Spec 046, R1 : Classique (spec 043) ou Surprise.
  mode             LoyaltyMode @default(classic)
  stampsRequired   Int         @default(10)
  minOrderMinor    Int         @default(0)
  /// Récompense du mode Classique ; facultative en mode Surprise.
  rewardItemId     String?     @db.Uuid
  /// Spec 046, R4 : un cadeau toutes les `surpriseMin` à `surpriseMax` commandes.
  surpriseMin      Int         @default(2)
  surpriseMax      Int         @default(5)
  /// Spec 046, R11 : validité d'un cadeau, en jours après son déblocage.
  giftValidityDays Int         @default(30)
  isActive         Boolean     @default(true)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
}

enum LoyaltyMode {
  classic
  surprise
}

enum LoyaltyPrizeKind {
  /// Un plat de la carte, offert par le geste de la spec 033.
  menu_item
  /// Un lot libre (bonbons, bon pour un jus…), remis à la main.
  free
}

/// Spec 046, R2 : un lot du panier de cadeaux. Retiré, il est archivé : les cadeaux tirés le gardent.
model LoyaltyPrize {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  establishmentId String           @db.Uuid
  kind            LoyaltyPrizeKind
  menuItemId      String?          @db.Uuid
  name            String
  imageId         String?          @unique @db.Uuid
  /// Chance d'être tiré, de 1 à 100 (proportion du total des lots disponibles).
  weight          Int
  /// Spec 046, R6 : stock mensuel ; null = sans limite.
  monthlyStock    Int?
  position        Int              @default(0)
  archivedAt      DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  image MenuImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([establishmentId, archivedAt])
}

/// Spec 046, R6 : nombre de tirages d'un lot dans un mois (« 2026-11 »).
model LoyaltyPrizeDraw {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @db.Uuid
  establishmentId String @db.Uuid
  prizeId         String @db.Uuid
  month           String
  count           Int    @default(0)

  @@unique([prizeId, month])
  @@index([establishmentId])
}

/// Spec 046 : un cadeau débloqué au règlement, emballé jusqu'à ce que le client le déballe.
model LoyaltyGift {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  establishmentId String    @db.Uuid
  cardId          String    @db.Uuid
  prizeId         String    @db.Uuid
  /// Session dont le règlement l'a débloqué : un déblocage par règlement.
  unlockSessionId String    @unique @db.Uuid
  /// Nombre de tampons de la carte au déblocage (place du cadeau sur la vague).
  atStamp         Int
  unlockedAt      DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  revealedAt      DateTime? @db.Timestamptz(3)
  celebratedAt    DateTime? @db.Timestamptz(3)
  /// Spec 046, R10 : session où il est utilisé ; un cadeau par session.
  useSessionId    String?   @unique @db.Uuid
  tableId         String?   @db.Uuid
  requestedAt     DateTime? @db.Timestamptz(3)
  usedAt          DateTime? @db.Timestamptz(3)
  usedById        String?   @db.Uuid
  /// Commande offerte créée à la validation d'un plat de la carte.
  requestId       String?   @db.Uuid

  @@index([cardId])
  @@index([establishmentId, requestedAt])
}

/// Spec 043, R2 : carte d'un client, identifiée par un jeton aléatoire gardé dans son téléphone (haché ici).
model LoyaltyCard {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  establishmentId String   @db.Uuid
  tokenHash       String   @unique
  stamps          Int      @default(0)
  rewardsRedeemed Int      @default(0)
  /// Spec 046, R5 : tampons qui débloquent le prochain cadeau ; tiré par le serveur, jamais envoyé au téléphone.
  nextGiftAt      Int?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([establishmentId])
}

/// Spec 043, R3 et R5 : un tampon par visite (session) au plus.
model LoyaltyStamp {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  establishmentId String   @db.Uuid
  cardId          String   @db.Uuid
  sessionId       String   @unique @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([cardId])
}

/// Spec 043, R4 et R5 : récompense demandée par le client, validée par un serveur ; une par visite au plus.
model LoyaltyRedemption {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  establishmentId String    @db.Uuid
  cardId          String    @db.Uuid
  sessionId       String    @unique @db.Uuid
  tableId         String    @db.Uuid
  rewardItemId    String    @db.Uuid
  /// Commande offerte créée à la validation.
  requestId       String?   @db.Uuid
  validatedAt     DateTime? @db.Timestamptz(3)
  validatedById   String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@index([establishmentId, validatedAt])
}

/// Spec 033, R4 et R5 : une ligne offerte. La ligne de commande reste figée (append-only, spec 001) :
/// offrir ajoute cette entrée, retirer le cadeau la supprime. La ligne vaut alors 0 dans le total de la commande.
model ServiceRequestItemOffer {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  establishmentId String   @db.Uuid
  requestId       String   @db.Uuid
  itemId          String   @unique @db.Uuid
  offeredById     String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  item ServiceRequestItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([requestId])
}
